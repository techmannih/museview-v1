{
  "name": "@tsci/museview-v1",
  "version": "0.1.0",
  "private": true,
  "description": "MuseView V1 ESP32-S3 camera board with standard 5 V USB-C power",
  "main": "index.circuit.tsx",
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "start": "bun scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsci build index.circuit.tsx --disable-parts-engine --autorouter-timeout 600s",
    "build:preview": "tsci build index.circuit.tsx --pcb-png --schematic-png --3d-png --svgs --autorouter-timeout 600s --disable-parts-engine",
    "build:handoff": "tsci build index.circuit.tsx --kicad-project-zip --step --glbs --autorouter-timeout 600s --disable-parts-engine",
    "snapshot": "tsci snapshot index.circuit.tsx --disable-parts-engine",
    "snapshot:update": "tsci snapshot index.circuit.tsx --update --disable-parts-engine",
    "snapshot:3d": "tsci snapshot index.circuit.tsx --3d --camera-preset top-left-corner --disable-parts-engine",
    "snapshot:3d:update": "tsci snapshot index.circuit.tsx --update --3d --camera-preset top-left-corner --disable-parts-engine",
    "check:contract": "bun scripts/check-contract.mjs",
    "check:assembly": "bun scripts/check-assembly.mjs",
    "check:decoupling": "bun scripts/check-decoupling.mjs",
    "check:routing": "bun scripts/check-routing.mjs",
    "export:assembly": "bun scripts/export-assembly.mjs",
    "render:sheets": "bun scripts/render-sheets.mjs",
    "verify": "bun run typecheck && bun run check:firmware-pins && bunx tsci check netlist && bunx tsci check schematic-placement && bunx tsci check placement && bunx tsci check routing-difficulty && bun run build && bun run check:schematic-style && bun run check:contract && bun run check:camera-supply && bun run check:routing && bun run check:decoupling && bun run check:assembly && bun test scripts/*.test.mjs && bunx tsci check shorts dist/index/circuit.json",
    "check": "bun run verify",
    "generate:firmware-pins": "bun scripts/generate-firmware-pins.mjs",
    "check:firmware-pins": "bun scripts/generate-firmware-pins.mjs --check",
    "export:release": "bun scripts/export-release.mjs",
    "normalize:step": "bun scripts/normalize-step.mjs",
    "regenerate:routing": "bun scripts/regenerate-routing.mjs",
    "capture:routing": "bun scripts/capture-routing-input.mjs",
    "check:camera-supply": "bun scripts/check-camera-supply.mjs",
    "check:schematic-style": "bun scripts/check-schematic-style.mjs"
  },
  "devDependencies": {
    "@tscircuit/circuit-json-schematic-placement-analysis": "https://jscdn.tscircuit.com/@tscircuit/circuit-json-schematic-placement-analysis/0.0.39.tgz",
    "@tscircuit/circuit-json-util": "0.0.116",
    "@tscircuit/math-utils": "0.0.36",
    "@tscircuit/solver-utils": "0.0.16",
    "@types/react": "19.2.18",
    "calculate-elbow": "0.0.12",
    "circuit-json-to-connectivity-map": "0.0.32",
    "circuit-json-to-kicad": "0.0.230",
    "circuit-to-svg": "0.0.433",
    "graphics-debug": "0.0.95",
    "polygon-clipping": "0.15.7",
    "schematic-symbols": "0.0.248",
    "tscircuit": "0.0.2687",
    "typescript": "5.9.3"
  }
}
